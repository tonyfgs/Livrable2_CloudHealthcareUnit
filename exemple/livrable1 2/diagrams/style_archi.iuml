' ===== Charte des diagrammes d'architecture =====
!include style.iuml
skinparam componentStyle rectangle
skinparam rectangle {
  BorderColor #6B7785
  BackgroundColor #FFFFFF
  FontStyle plain
}
skinparam rectangle<<src>> {
  BackgroundColor #E8F1FB
  BorderColor #2F6DB5
}
skinparam rectangle<<bronze>> {
  BackgroundColor #F6E3D0
  BorderColor #A0612B
}
skinparam rectangle<<silver>> {
  BackgroundColor #ECEFF3
  BorderColor #6B7785
}
skinparam rectangle<<gold>> {
  BackgroundColor #FFF4CC
  BorderColor #B8901A
}
skinparam rectangle<<secu>> {
  BackgroundColor #FBE5E3
  BorderColor #B03A2E
}
skinparam rectangle<<gouv>> {
  BackgroundColor #E7F5EC
  BorderColor #2E7D4F
}
skinparam rectangle<<zone>> {
  BackgroundColor #FCFCFD
  BorderColor #9CA3AF
  BorderStyle dashed
  FontColor #374151
}
skinparam database {
  BackgroundColor #E8F1FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFF4CC
  BorderColor #B8901A
}
skinparam folder {
  BackgroundColor #E8F1FB
  BorderColor #2F6DB5
}
hide stereotype
