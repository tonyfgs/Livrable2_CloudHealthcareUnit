@startuml
!include style_data.iuml
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 34
title S1 : schéma réel de la base PostgreSQL (dump DATA2023)
skinparam class<<orph>> {
  HeaderBackgroundColor #F3F4F6
  BorderColor #9CA3AF
  FontColor #6B7280
}
entity "Patient · 100 000" as Patient <<ident>> {
  {field} <u>Id_patient</u> : integer
  {field} Nom, Prenom, Adresse, Ville
  {field} Code_postal, Pays, EMail, Tel
  {field} Sexe : male / female
  {field} Date : texte M/J/AAAA
  {field} Age : figé mi-2021
  {field} Num_Secu, Groupe_sanguin
  {field} Poid, Taille
}
entity "Consultation · 1 027 157" as Consultation <<src>> {
  {field} <u>Num_consultation</u> : identity
  {field} #Id_patient, #Id_prof_sante
  {field} #Code_diag, #Id_mut
  {field} Date : date
  {field} Motif, Heure_debut, Heure_fin
}
entity "Professionnel_de_sante · 1 048 575" as Prof <<ident>> {
  {field} <u>Identifiant</u> : RPPS / ADELI
  {field} Civilite, Nom, Prenom
  {field} Profession, Type_identifiant
  {field} Categorie_professionnelle
  {field} #Code_specialite
}
entity "Specialites · 93" as Spe <<src>> {
  {field} <u>Code_specialite</u>
  {field} Fonction, Specialite
}
entity "Diagnostic · 15 490" as Diag <<src>> {
  {field} <u>Code_diag</u>
  {field} Diagnostic
}
entity "Mutuelle · 254" as Mut <<src>> {
  {field} <u>Id_Mut</u>
  {field} Nom, Adresse
}
entity "Adher · 96 671" as Adher <<src>> {
  {field} #Id_patient, #Id_mut
}
entity "Hors périmètre décisionnel" as HP <<orph>> {
  {field} Prescription · 1 003 845
  {field} Medicaments · 15 455
  {field} Laboratoire · 677 ; Salle · 201 735
  {field} AAAA, date · 82 216 (sans clé)
}
Patient <-down- Consultation
Consultation -down-> Prof
Consultation -down-> Diag
Consultation -right-> Mut
Prof -down-> Spe
Adher -up-> Patient
Adher -down-> Mut
HP .up.> Consultation : <size:11>liens sans FK</size>
legend bottom
  <color:#B03A2E><b>■</b></color>   identifiants directs  <color:#2F6DB5><b>■</b></color>   métier / référentiel  <color:#9CA3AF><b>■</b></color>   hors périmètre
  <u>souligné</u> : clé primaire ; # : clé étrangère (FK NOT VALID) ; flèche : référençante → référencée
endlegend
@enduml
