@startuml
!include style_archi.iuml
skinparam nodesep 18
skinparam ranksep 26
skinparam linetype ortho
title Architecture retenue : Talend Open Studio for Big Data 7.3.1 et Hive sur cluster Cloudera

rectangle "<b>SOURCES</b>\nS1 PostgreSQL 14 (base DATA2023) + séjours CSV · S2 annuaire santé (CSV)\nS3 HAS e-Satis / IQSS (CSV, XLSX) · S4 INSEE décès (CSV) · COG, CIM-10" as SRC <<src>>

rectangle "Poste ETL (Windows) : Talend Open Studio for Big Data 7.3.1, JDK 8" as TOS <<zone>> {
  rectangle "<b>J_MASTER</b> (mensuel)\ntPrejob : tContextLoad (dev / rec / prod)\ntRunJob : ingestion → Silver →\ndimensions → faits → J_PUB" as MST <<gouv>>
  rectangle "<b>Jobs Talend</b>\nJ_ING_* · J_SLV_* · J_DIM_* (12)\nJ_FAIT_* (4) · J_PUB\ntMap, tUniqRow, tAggregateRow…" as JOBS <<silver>>
  rectangle "<b>Journaux d'exécution</b>\ntLogCatcher, tStatCatcher,\ntFlowMeterCatcher → base ops\n(PostgreSQL), tSendMail" as LOG <<gouv>>
}

rectangle "Cluster Cloudera (CDH 5.12 QuickStart en formation) : HDFS, Hive, Hue, YARN" as CDH <<zone>> {
  rectangle "<b>BRONZE</b> · HDFS /user/cloudera/chu/bronze\ncopie fidèle des extractions (TXT)\nbase Hive chu_bronze (non exposée)" as BR <<bronze>>
  rectangle "<b>SILVER</b> · HDFS …/chu/silver\ntypé, dédoublonné, conformé,\npseudonymisé (HMAC) · chu_silver" as SI <<silver>>
  rectangle "<b>GOLD</b> · HDFS …/chu/gold\nun répertoire par dimension et par fait,\ntables externes Hive chu_gold, vues v_ind_*" as GO <<gold>>
  rectangle "<b>HiveServer2</b> (port 10000)\nrequêtes HiveQL, vues\nd'indicateurs ; Hue (8888)" as HS2 <<gold>>
}
rectangle "<b>RESTITUTION</b> · Power BI Desktop (ressource du cours)\nconnecteur ODBC Hive ; vues agrégées seulement" as BI <<gold>>
rectangle "<b>UTILISATEURS</b>\ndirection · praticiens · analystes / DIM" as USR <<src>>

SRC -down-> JOBS : ①
JOBS -down-> BR : ② tHDFSOutput
BR -down-> SI : ③
SI -down-> GO : ④
GO -down-> HS2
HS2 -down-> BI : ODBC
BI -down-> USR
MST .right.> JOBS
JOBS .right.> LOG
legend bottom
  ① tPostgresqlInput, tFileInputDelimited, tFileInputExcel  ② écriture texte ';' dans HDFS  ③ jobs J_SLV_* (relecture tHDFSInput)
  ④ jobs J_DIM_* et J_FAIT_* puis publication J_PUB (tHiveRow : ALTER TABLE … SET LOCATION / ADD PARTITION)
  Trait plein : données ; pointillé : orchestration et journalisation. Développement : quickstart.cloudera = 10.10.10.128 (fichier hosts du poste)
endlegend
@enduml
