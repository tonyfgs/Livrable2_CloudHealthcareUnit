@startuml
!include style_flow.iuml
skinparam ActivityFontSize 13
title Job maître J_MASTER : chargement mensuel (chargement = AAAAMM)
start
:<b>tPrejob</b> : tFileInputDelimited (clé=valeur) → <b>tContextLoad</b>
(contexte dev / rec / prod) ; ligne ops.lot (EN_COURS);
partition "Ingestion vers Bronze : une source après l'autre (tRunJob)" #F6E3D0 {
  :<b>J_ING_S1..S4</b> : tPostgresqlInput / tFileInputDelimited / tFTPGet (SFTP)
  → tHDFSOutput (texte ';') dans bronze/<entité>/chargement=AAAAMM
  contrôles RQ-01 à 06 : fichier déjà reçu, colonnes, encodage, volume;
  if (règle bloquante en échec ?) then (oui)
    #FBE5E3:quarantaine, tWarn + tSendMail : la source
    reste au dernier état publié;
    detach
  else (non)
  endif
}
partition "Silver : J_SLV_*" #ECEFF3 {
  :tHDFSInput → tMap (typage, règles RG) → tUniqRow
  pseudonymisation HMAC (routine Java) ; rejets → silver/rejet
  contrôles RQ-07 à 19, 23 à 28 (tSchemaComplianceCheck, tFilterRow);
}
partition "Gold : dimensions puis faits, dans des répertoires de travail" #FFF4CC {
  :<b>J_DIM_*</b> (12) : tMap avec lookup de la dimension publiée,
  clé de substitution, SCD 2 (tAddCRCRow) → gold/<dim>/chargement=AAAAMM
  <b>J_FAIT_*</b> (4) : tMap lookups des clés (−1, −3, −4) → tAggregateRow
  → gold/<fait>/chargement=AAAAMM;
  :<b>J_PUB</b> : tHiveRow sur les tables *_stg : unicité, orphelins,
  réconciliation des comptes (RQ-20 à 22, 29, 30);
  if (un contrôle bloquant en échec ?) then (oui)
    #FBE5E3:aucune table ne bascule ; le répertoire du
    lot reste en place pour analyse ; alerte;
  else (non)
    :bascule dimensions puis faits :
    ALTER TABLE … SET LOCATION
    ALTER TABLE … ADD PARTITION;
  endif
}
:<b>tPostjob</b> : ops.lot (OK / ECHEC), statistiques (tStatCatcher), courriel;
stop
note right
  Erreur d'un sous-job :
  tRunJob « Die on child
  error » → tLogCatcher
  → ops.journal, ECHEC
  <b>J_MNT</b> : purge des
  répertoires de lot au-delà
  des 3 derniers
end note
@enduml
