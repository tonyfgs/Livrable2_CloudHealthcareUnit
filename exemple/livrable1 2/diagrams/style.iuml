' ===== Charte graphique commune (Livrable 1) =====
' Palette : Sources #E8F1FB/#2F6DB5 | Bronze #F6E3D0/#A0612B | Silver #ECEFF3/#6B7785
'           Gold #FFF4CC/#B8901A | Sécurité #FBE5E3/#B03A2E | Gouvernance #E7F5EC/#2E7D4F
'           Texte #1F2937 | Accent CESI #FFD400
skinparam defaultFontName Lato
skinparam defaultFontSize 13
skinparam defaultFontColor #1F2937
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #374151
skinparam ArrowFontSize 11
skinparam ArrowFontColor #374151
skinparam ArrowThickness 1.2
skinparam BackgroundColor white
skinparam padding 2
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #B8901A
skinparam NoteFontSize 11
skinparam TitleFontSize 15
skinparam LegendBackgroundColor #F9FAFB
skinparam LegendBorderColor #9CA3AF
skinparam LegendFontSize 11
